cluster.name: "{{ elasticsearch_cluster_name }}"
node.name: "{{ inventory_hostname }}"
path.data: "{{ elasticsearch_data_path }}"
path.logs: /var/log/elasticsearch
network.host: "{{ elasticsearch_bind_address }}"
http.port: {{ elasticsearch_http_port }}
transport.port: {{ elasticsearch_transport_port }}
discovery.type: single-node

xpack.security.enabled: true
xpack.security.http.ssl:
  enabled: true
  certificate: "{{ elasticsearch_http_certificate }}"
  key: "{{ elasticsearch_http_key }}"
  certificate_authorities:
    - "{{ elasticsearch_ca_certificate }}"
xpack.security.transport.ssl:
  enabled: true
  verification_mode: certificate
  certificate: "{{ elasticsearch_http_certificate }}"
  key: "{{ elasticsearch_http_key }}"
  certificate_authorities:
    - "{{ elasticsearch_ca_certificate }}"
